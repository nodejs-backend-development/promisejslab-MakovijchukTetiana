/** Завдання 1.2: 
 * Створіть проміс, який резолвиться з числом після перевірки
 * Якщо число парне - resolve, якщо непарне - reject
 * * @param {number} number 
 * @returns {Promise<number, string>}
 */
function checkEvenNumber(number) {
    return new Promise((resolve, reject) => {
        if (number % 2 === 0) {
            // Якщо число парне, викликаємо resolve
            resolve(number);
        } else {
            // Якщо число непарне, викликаємо reject із повідомленням про помилку
            reject(`Число ${number} є непарним`);
        }
    });
}

// Перевірка:
checkEvenNumber(4)
    .then(num => console.log(' Тест 1.2 (парне):', num))
    .catch(err => console.log(' Помилка:', err));

checkEvenNumber(5)
    .then(num => console.log(' Не повинно виконатися'))
    .catch(err => console.log(' Тест 1.2 (непарне):', err));




    /** Завдання 1.4:
 * Створіть проміс, який симулює авторизацію користувача
 * * @param {string} username 
 * @param {string} password 
 * @returns {Promise<{username: string, authenticated: boolean}, string>}
 */
function authenticateUser(username, password) {
    return new Promise((resolve, reject) => {
        // 1. Перевірка на порожнє ім'я користувача
        if (!username || username.trim() === '') {
            return reject('Username is required');
        }

        // 2. Перевірка на порожній пароль
        if (!password || password.trim() === '') {
            return reject('Password is required');
        }

        // 3. Перевірка довжини пароля
        if (password.length < 6) {
            return reject('Password too short');
        }

        // 4. Якщо всі перевірки пройдено — успіх
        resolve({
            username: username,
            authenticated: true
        });
    });
}

// --- Перевірка результатів ---

// Тест 1: Успішна авторизація
authenticateUser('john', 'password123')
    .then(user => console.log(' Тест 1.4 (успіх):', user))
    .catch(err => console.log(' Помилка:', err));

// Тест 2: Порожній username
authenticateUser('', 'password123')
    .then(user => console.log(' Не повинно виконатися'))
    .catch(err => console.log(' Тест 1.4 (немає username):', err));

// Тест 3: Короткий пароль
authenticateUser('john', '12345')
    .then(user => console.log(' Не повинно виконатися'))
    .catch(err => console.log(' Тест 1.4 (короткий пароль):', err));





    /** Завдання 1.5:
 * Створіть функцію, яка перевіряє вік користувача
 * * @param {number} age 
 * @returns {Promise<{age: number, category: string}, string>}
 */
function checkAge(age) {
    return new Promise((resolve, reject) => {
        // 1. Перевірка на некоректне значення (від'ємне число)
        if (age < 0) {
            return reject('Invalid age');
        }

        // 2. Перевірка на неповноліття
        if (age < 18) {
            return reject('Too young');
        }

        // 3. Категорія "Senior" (65+)
        if (age >= 65) {
            return resolve({ age, category: 'senior' });
        }

        // 4. Категорія "Adult" (від 18 до 64 включно)
        resolve({ age, category: 'adult' });
    });
}

// Перевірка:
checkAge(25)
    .then(res => console.log('Тест 1.5 (25 років):', res))
    .catch(err => console.error('Помилка:', err));

checkAge(70)
    .then(res => console.log('Тест 1.5 (70 років):', res))
    .catch(err => console.error('Помилка:', err));

checkAge(15)
    .then(res => console.log('Не повинно виконатися'))
    .catch(err => console.log('Тест 1.5 (15 років):', err));

checkAge(-5)
    .then(res => console.log('Не повинно виконатися'))
    .catch(err => console.log('Тест 1.5 (-5 років):', err));


