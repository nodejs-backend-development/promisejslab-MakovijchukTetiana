/**
 * Створіть систему retry з обмеженням за часом
 * Навіть якщо є спроби, зупиніться якщо пройшло багато часу
 *
 * @param {Function} fn 
 * @param {Object} options - {maxRetries, maxTime, initialDelay}
 * @returns {Promise}
 */
function retryWithTimeout(fn, options = {}) {
    const {
        maxRetries = 3,
        maxTime = 5000,  // Максимальний час в мс
        initialDelay = 100
    } = options;

    // Фіксуємо час початку, щоб рахувати, скільки минуло
    const startTime = Date.now();

    // Внутрішня асинхронна функція для спроб
    async function attempt(currentRetry) {
        // 1. Перевіряємо, чи не вичерпано загальний час ПЕРЕД спробою
        if (Date.now() - startTime >= maxTime) {
            throw new Error('Timeout exceeded');
        }

        try {
            // Намагаємося виконати передану функцію
            return await fn();
        } catch (error) {
            // 2. Якщо сталася помилка, перевіряємо ліміт спроб
            if (currentRetry >= maxRetries) {
                throw new Error(`Max retries (${maxRetries}) reached`);
            }

            // Перевіряємо час ще раз ПІСЛЯ помилки (щоб не робити зайву паузу)
            if (Date.now() - startTime >= maxTime) {
                throw new Error('Timeout exceeded');
            }

            // Робимо паузу перед наступною спробою
            await new Promise(resolve => setTimeout(resolve, initialDelay));

            // Рекурсивно переходимо до наступної спроби
            return attempt(currentRetry + 1);
        }
    }

    // Запускаємо першу спробу (нульовий індекс)
    return attempt(0);
}

