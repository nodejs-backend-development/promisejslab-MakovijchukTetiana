/**
 * Створіть універсальну retry систему з усіма можливостями
 *
 * @param {Function} fn 
 * @param {Object} config
 * @returns {Promise<{result: any, attempts: number, totalTime: number, errors: Error[]}>}
 */
function universalRetry(fn, config = {}) {
    const defaults = {
        maxRetries: 3,
        maxTime: 10000,
        initialDelay: 100,
        maxDelay: 5000,
        backoffMultiplier: 2,
        shouldRetry: () => true,
        onRetry: () => {},
        onSuccess: () => {},
        onFailure: () => {}
    };

    // Об'єднуємо дефолтні налаштування з переданими користувачем
    const options = { ...defaults, ...config };

    const startTime = Date.now();
    const errors = [];
    let attempts = 0;

    return new Promise((resolve, reject) => {
        const execute = async () => {
            const currentTime = Date.now();
            const elapsedTime = currentTime - startTime;

            // 1. Абсолютний захист по часу (Global Timeout)
            if (elapsedTime >= options.maxTime) {
                const timeoutErr = new Error(`Max time (${options.maxTime}ms) exceeded`);
                options.onFailure(timeoutErr);
                return reject(timeoutErr);
            }

            attempts++;

            try {
                // Спробуємо виконати цільову функцію
                const result = await fn();
                
                // Якщо успіх — збираємо статистику
                const stats = {
                    result,
                    attempts,
                    totalTime: Date.now() - startTime,
                    errors
                };
                
                options.onSuccess(stats);
                resolve(stats);

            } catch (error) {
                errors.push(error);
                
                // Перевіряємо умови для продовження спроб
                const canRetryAttempts = attempts < options.maxRetries;
                const canRetryCondition = options.shouldRetry(error);
                
                if (canRetryAttempts && canRetryCondition) {
                    // 2. Гнучка стратегія затримки (Exponential Backoff з обмеженням maxDelay)
                    let delay = options.initialDelay * Math.pow(options.backoffMultiplier, attempts - 1);
                    delay = Math.min(delay, options.maxDelay);

                    // Якщо очікування цієї паузи перевищить глобальний ліміт часу - зупиняємось
                    if ((Date.now() - startTime) + delay >= options.maxTime) {
                        options.onFailure(error);
                        return reject(new Error('Max time would be exceeded during delay'));
                    }

                    // 4. Callback для моніторингу
                    options.onRetry(attempts, error);

                    // Чекаємо і рекурсивно запускаємо знову
                    setTimeout(execute, delay);
                } else {
                    // Якщо ліміт спроб вичерпано, або помилка не підлягає retry
                    options.onFailure(error);
                    reject(error);
                }
            }
        };

        // Запускаємо першу ітерацію
        execute();
    });
}

