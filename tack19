/**
 * Створіть "розумний" retry з адаптивною затримкою
 * Затримка залежить від типу помилки
 */

class RateLimitError extends Error {
    constructor(retryAfter) {
        super('Rate limit exceeded');
        this.name = 'RateLimitError';
        this.retryAfter = retryAfter; // seconds
    }
}

class ServerError extends Error {
    constructor(message) {
        super(message);
        this.name = 'ServerError';
    }
}

/**
 * @param {Function} fn 
 * @param {number} maxRetries 
 * @returns {Promise}
 */
function smartRetry(fn, maxRetries) {
    async function attempt(retryCount) {
        try {
            // Намагаємося виконати запит
            return await fn();
        } catch (error) {
            // Якщо перевищили кількість спроб — припиняємо
            if (retryCount >= maxRetries) {
                throw error;
            }

            let delay = 0;

            // 1. Для RateLimitError чекаємо вказану кількість секунд
            if (error instanceof RateLimitError) {
                delay = error.retryAfter * 1000; // переводимо секунди в мілісекунди
                console.log(`⏳ [RateLimit] Перевищено ліміт. Чекаємо ${error.retryAfter}с...`);
            } 
            // 2. Для ServerError використовуємо експоненційну затримку
            else if (error instanceof ServerError) {
                delay = Math.pow(2, retryCount) * 100; 
                console.log(` [ServerError] Сервер перевантажено. Спроба ${retryCount}, чекаємо ${delay}мс...`);
            } 
            // 3. Для невідомих помилок (наприклад, синтаксичних) одразу падаємо
            else {
                console.log(' Невідома помилка. Припиняємо спроби.');
                throw error;
            }

            // Робимо паузу перед наступною спробою
            await new Promise(resolve => setTimeout(resolve, delay));
            
            // Запускаємо наступну спробу
            return attempt(retryCount + 1);
        }
    }

    return attempt(1); // Починаємо з першої спроби
}

